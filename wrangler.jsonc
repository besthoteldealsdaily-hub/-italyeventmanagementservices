{
  "$schema": "node_modules/wrangler/config-schema.json",
  // MUST match the Worker name in the Cloudflare dashboard (Workers Builds fails otherwise).
  "name": "italyeventmanagementservices",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Same value as "name" above.
      "service": "italyeventmanagementservices"
    }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "italyeventmanagementservices-db" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "italyeventmanagementservices-docs" }],
  "vars": { "NEXT_PUBLIC_ALLOW_INDEXING": "true" },
  "observability": { "enabled": true }
}
