# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://italyeventmanagementservices.com
# Keep false until launch. When true: robots allows crawling + pages become indexable.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Contact (shown on the site) ──────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=info@italyeventmanagementservices.com
# Optional. Example: +39 06 0000 0000
NEXT_PUBLIC_PHONE=
# Optional. Digits only, international format, no "+": e.g. 393331234567
NEXT_PUBLIC_WHATSAPP=

# ── Company details (fill after the SRL exists; hidden while empty) ──
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_VAT_ID=
NEXT_PUBLIC_COMPANY_REA=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_SHARE_CAPITAL=
NEXT_PUBLIC_COMPANY_PEC=

# ── Travel-agency licence (set ONLY once the SCIA is filed and insurance is bound) ──
NEXT_PUBLIC_AGENCY_LICENSED=false
NEXT_PUBLIC_AGENCY_AUTHORISATION=
NEXT_PUBLIC_AGENCY_INSURER=

# ── Social (optional) ────────────────────────────────
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# ── Quote-request delivery (server-side; at least one email method is required in production) ──
# Option A: Gmail (or Google Workspace) SMTP. Create an "App Password" on the sending Google
# account (needs 2-Step Verification on): https://myaccount.google.com/apppasswords
# SMTP_USER must be the real Gmail login (e.g. you@gmail.com), not just any alias — Google won't
# issue an app password for an address that isn't an actual mailbox on your Google account.
# SMTP_FROM can be a verified "Send As" alias (Gmail Settings → Accounts → "Send mail as"), e.g.
# info@italyeventmanagementservices.com, once you've added and confirmed it there.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Quotes <quotes@italyeventmanagementservices.com>"

# Option B: Email via Resend (https://resend.com): verify your sending domain first. Used
# automatically as a fallback if SMTP_* above isn't set (or if the SMTP send fails).
RESEND_API_KEY=
QUOTE_FROM_EMAIL="Quotes <quotes@italyeventmanagementservices.com>"

QUOTE_TO_EMAIL=you@example.com
# Generic webhook (Slack/Mattermost-style {text}, or Make/n8n/Zapier JSON). Great for a Telegram/WhatsApp alert.
LEAD_WEBHOOK_URL=

# ── Admin panel & operations system (Cloudflare D1 database) ──
# Set these as RUNTIME SECRETS in the Cloudflare dashboard (Workers → Settings → Variables and Secrets) — never NEXT_PUBLIC_.
# Full guide: docs/ADMIN-SETUP.md
ADMIN_PASSWORD=
# 16+ random characters (signs the admin login cookie)
SESSION_SECRET=

# ── Card payments (optional; the payment page shows bank transfer only until these are set) ──
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://YOUR-DOMAIN/api/stripe/webhook, event checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# ── Optional extras ──────────────────────────────────
# Cloudflare Turnstile bot check on the quote form (free). Site key is public (build variable), secret key is a runtime secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Google Analytics 4 measurement ID (loads only after the visitor accepts analytics cookies)
NEXT_PUBLIC_GA_ID=
# Search Console "HTML tag" verification token (content value only)
NEXT_PUBLIC_GSC_VERIFICATION=
# Link asked of happy customers after a 4–5★ private review
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
