# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://italyeventmanagementservices.com
# Keep false until launch. When true: robots allows crawling + pages become indexable.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Contact (shown on the site) ──────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=info@italyeventmanagementservices.com
# Optional. Example: +39 06 0000 0000
NEXT_PUBLIC_PHONE=
# Optional. Digits only, international format, no "+": e.g. 393331234567
NEXT_PUBLIC_WHATSAPP=

# ── Company details (fill after the SRL exists; hidden while empty) ──
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_VAT_ID=
NEXT_PUBLIC_COMPANY_REA=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_SHARE_CAPITAL=
NEXT_PUBLIC_COMPANY_PEC=

# ── Travel-agency licence (set ONLY once the SCIA is filed and insurance is bound) ──
NEXT_PUBLIC_AGENCY_LICENSED=false
NEXT_PUBLIC_AGENCY_AUTHORISATION=
NEXT_PUBLIC_AGENCY_INSURER=

# ── Social (optional) ────────────────────────────────
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# ── Quote-request delivery (server-side; at least one is required in production) ──
# Email via Resend (https://resend.com): verify your sending domain first.
RESEND_API_KEY=
QUOTE_FROM_EMAIL="Quotes <quotes@italyeventmanagementservices.com>"
QUOTE_TO_EMAIL=you@example.com
# Generic webhook (Slack/Mattermost-style {text}, or Make/n8n/Zapier JSON). Great for a Telegram/WhatsApp alert.
LEAD_WEBHOOK_URL=
